{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["Super Admin", "Admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "E-commerce product listing in Offer Flow catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nameBn": { "type": "string", "maxLength": 200 },
        "images": { "type": "array", "description": "Array of compressed image data URLs or HTTPS URLs (max 10)." },
        "description": { "type": "string", "maxLength": 5000 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subcategory": { "type": "string", "maxLength": 120 },
        "brand": { "type": "string", "maxLength": 120 },
        "tags": { "type": "array" },
        "colors": { "type": "array", "description": "Available product color options (max 20)." },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isFlashSale": { "type": "boolean" },
        "specifications": { "type": "array" },
        "deliveryInfo": { "type": "string", "maxLength": 1000 },
        "returnInfo": { "type": "string", "maxLength": 1000 },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "images", "price", "discountPrice", "stock", "sku", "category", "status", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Storefront product category or catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "nameBn": { "type": "string", "maxLength": 120 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 120 },
        "image": { "type": "string", "maxLength": 400000 },
        "icon": { "type": "string", "maxLength": 60 },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "image", "isActive", "order", "createdAt", "updatedAt"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Hero or promotional banner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "badge": { "type": "string", "maxLength": 100 },
        "image": { "type": "string", "maxLength": 500000 },
        "buttonText": { "type": "string", "maxLength": 80 },
        "link": { "type": "string", "maxLength": 300 },
        "placement": { "type": "string", "enum": ["homepage_hero", "promo_section", "product_page", "category_page", "popup", "announcement"] },
        "showOnHomepage": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "image", "placement", "showOnHomepage", "isActive", "order", "createdAt", "updatedAt"]
    },
    "Advertisement": {
      "title": "Advertisement",
      "description": "Promotional advertisement block.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "image": { "type": "string", "maxLength": 500000 },
        "buttonText": { "type": "string", "maxLength": 80 },
        "targetUrl": { "type": "string", "maxLength": 300 },
        "placement": { "type": "string", "enum": ["homepage_hero", "promo_section", "product_page", "category_page", "popup", "announcement"] },
        "showOnHomepage": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "image", "placement", "showOnHomepage", "isActive", "createdAt", "updatedAt"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Tech and shopping guide article.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 250 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 250 },
        "excerpt": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 25000 },
        "featuredImage": { "type": "string", "maxLength": 500000 },
        "author": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 120 },
        "tags": { "type": "array" },
        "isPublished": { "type": "boolean" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "excerpt", "content", "isPublished", "createdAt", "updatedAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon code.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 1, "maxLength": 50 },
        "type": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "usageLimit": { "type": "number" },
        "timesUsed": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "type", "value", "minOrderValue", "maxDiscount", "isActive", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productName": { "type": "string", "maxLength": 200 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "customerName", "rating", "comment", "isApproved", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order containing PII (restricted to owner and admin).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 30 },
        "email": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "minLength": 3, "maxLength": 500 },
        "district": { "type": "string", "minLength": 1, "maxLength": 100 },
        "area": { "type": "string", "maxLength": 100 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["cash_on_delivery", "whatsapp_cod"] },
        "internalNotes": { "type": "string", "maxLength": 1000 },
        "customerNote": { "type": "string", "maxLength": 1000 },
        "statusNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderNumber", "userId", "customerName", "phone", "address", "district", "items", "subtotal", "discount", "deliveryFee", "total", "status", "paymentMethod", "createdAt", "updatedAt"]
    },
    "OrderTracking": {
      "title": "OrderTracking",
      "description": "Non-PII public order tracking document keyed by orderNumber.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "statusNote": { "type": "string", "maxLength": 500 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "district": { "type": "string", "maxLength": 100 },
        "paymentMethod": { "type": "string", "enum": ["cash_on_delivery", "whatsapp_cod"] },
        "phoneLast4": { "type": "string", "maxLength": 4 },
        "customerNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "orderId", "status", "items", "subtotal", "discount", "deliveryFee", "total", "district", "paymentMethod", "createdAt", "updatedAt"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Storefront site settings and flash sale configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer account profile and saved delivery details keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 150 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "district": { "type": "string", "maxLength": 100 },
        "area": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 500 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin UIDs."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Customer user profiles and saved delivery info (owner and admin only)."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public product catalog."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Public product categories and catalogs."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Homepage and promo banners."
    },
    "/advertisements/{adId}": {
      "schema": { "$ref": "#/entities/Advertisement" },
      "description": "Promotional ads."
    },
    "/blogs/{blogId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Published blog articles."
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Discount coupons."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product reviews."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders with PII protected to admin and owning user."
    },
    "/order_tracking/{orderNumber}": {
      "schema": { "$ref": "#/entities/OrderTracking" },
      "description": "Non-PII order status tracking summary keyed by orderNumber."
    },
    "/site_config/{configId}": {
      "schema": { "$ref": "#/entities/SiteConfig" },
      "description": "Site settings and flash sale configuration."
    }
  }
}
